# Copier en .env (jamais commité) et remplir.
DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48 — ne plus jamais changer après la mise en service
OKPOST_CLE_CHIFFREMENT=

# URL Vercel (ou domaine final) du frontend — sert aux liens e-mail et au retour Meta
PUBLIC_URL=https://VOTRE-APP.vercel.app
# Origines autorisées (inutile en pratique avec le rewrite Vercel, mais gardez la même valeur)
CORS_ORIGINS=https://VOTRE-APP.vercel.app

IA_FOURNISSEUR=gemini
IA_DEBIT_MINUTE=8
GEMINI_API_KEY=
COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
IA_IMAGE_FOURNISSEUR=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

META_APP_ID=
META_APP_SECRET=

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_TLS=true
MAIL_FROM=OkPost <no-reply@my2-0.cloud>

# Compte super-admin créé au premier démarrage (12 caractères minimum)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
