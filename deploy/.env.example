# Copier en .env sur le VPS (jamais dans Git)
DB_PASSWORD=mot-de-passe-long-et-aleatoire
JWT_SECRET=au-moins-32-caracteres-aleatoires-a-generer
PUBLIC_URL=https://okpost.app
CORS_ORIGINS=https://okpost.app

# IA : gemini au lancement, claude plus tard
IA_FOURNISSEUR=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
IA_DEBIT_MINUTE=8

# Compte super-admin créé au premier démarrage (12 caractères minimum)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# E-mails (liens de validation, notifications)
MAIL_ENABLED=false
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_TLS=true
MAIL_FROM=OkPost <no-reply@okpost.app>
